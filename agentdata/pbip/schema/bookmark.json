{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bookmark",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "displayName": { "type": "string" },
    "explorationState": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "activeSection": { "type": "string" },
        "sections": { "type": "object" }
      },
      "required": ["version"]
    }
  },
  "required": ["$schema", "name", "displayName", "explorationState"]
}
