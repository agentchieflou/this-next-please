{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VisualContainer",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[0-9a-f]{20}$" },
    "position": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "tabOrder": { "type": "number" }
      },
      "required": ["x", "y", "width", "height"]
    },
    "visual": {
      "type": "object",
      "properties": {
        "visualType": { "type": "string" },
        "query": { "type": "object" },
        "sortDefinition": { "type": "object" },
        "objects": { "type": "object" },
        "visualContainerObjects": { "type": "object" },
        "filterConfig": { "$ref": "filterConfig.json" }
      },
      "required": ["visualType"]
    }
  },
  "required": ["$schema", "name", "position", "visual"]
}
