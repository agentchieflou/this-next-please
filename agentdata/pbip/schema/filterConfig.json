{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FilterConfig",
  "type": "object",
  "properties": {
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["Categorical", "Advanced", "TopN", "RelativeDate", "RelativeTime"] },
          "field": { "type": "object" },
          "filter": { "type": "object" }
        },
        "required": ["name", "type", "field", "filter"]
      }
    }
  }
}
