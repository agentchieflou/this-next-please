{
  "about": "The CI path map (#593 CI-1, plan .agent/out/ci-repo-restructure-plan.md §4.2, decision 23 on #429). `.github/scripts/ci_paths.py` reads it in the `changes` job. A path no group names turns every group on. Report only until CI-4 (#596): no job is skipped yet. tests/test_ci_paths.py and tests/test_hygiene_ci_paths.py keep it honest.",
  "groups": {
    "ci": {
      "everything": true,
      "paths": [
        ".github/workflows/**",
        ".github/scripts/**",
        ".github/ci-paths.json",
        ".gitignore",
        "pyproject.toml",
        "tests/conftest.py",
        "tests/shard.py",
        "tests/tier_matrix.py"
      ],
      "except": [
        ".github/scripts/smoke.*"
      ]
    },
    "py": {
      "paths": [
        "agentdata/**",
        "tests/**",
        "skills/**",
        "prompts/**",
        "themes/**",
        "contract/**",
        ".gitattributes",
        "tsconfig.json",
        "LICENSE",
        ".github/agent-lanes.json",
        ".github/pull_request_template.md",
        ".github/ISSUE_TEMPLATE/**"
      ],
      "except": [
        "agentdata/fleet/static/**"
      ]
    },
    "desk": {
      "paths": [
        "agentdata/fleet/**",
        "agentdata/cli_fleet.py",
        "agentdata/__init__.py",
        "agentdata/__main__.py",
        "agentdata/cli.py",
        "agentdata/cli_confluence.py",
        "agentdata/cli_git.py",
        "agentdata/cli_jira.py",
        "agentdata/cli_state.py",
        "agentdata/color.py",
