    },
    "static-only": {
      "only": [
        "agentdata/fleet/static/**"
      ]
    },
    "docs": {
      "paths": [
        "docs/**",
        "*.md",
        "HANDOFF.md"
      ]
    },
    "shells": {
      "paths": [
        ".github/scripts/smoke.{sh,ps1,cmd}"
      ]
    },
    "mobile": {
      "smoke_only": true,
      "paths": [
        "mobile/**",
        "tests/test_mobile_powerapp.py",
        "agentdata/fleet/{bridge,notify,approval,agentstate}.py"
      ]
    },
    "ide-vscode": {
      "paths": [
        "ide/vscode/**",
        "agentdata/fleet/serve.py",
        "docs/fleet-ide.md"
      ]
    },
    "ide-jetbrains": {
      "paths": [
        "ide/jetbrains/**",
        "agentdata/fleet/serve.py",
        "docs/fleet-ide.md"
      ]
    },
    "ide-desktop": {
      "paths": [
        "ide/desktop/**"
      ]
    }
  },
  "jobs": {
    "changes": {
      "always": true,
      "names": [
        "changes · which groups a filter would run (report only)"
      ]
    },
    "pytest": {
      "groups": [
        "py",
        "desk",
        "static-only",
        "docs",
        "ide-desktop"
      ],
      "names": [
        "ubuntu-latest · python 3.14"
      ]
    },
    "browser": {
      "groups": [
        "desk",
        "static-only"
      ],
      "names": [
        "ubuntu · python 3.14 · browser · shard 1/2",
        "ubuntu · python 3.14 · browser · shard 2/2"
      ]
    },
    "windows": {
      "groups": [
        "py",
        "desk",
        "static-only",
        "shells"
      ],
      "names": [
        "windows · python 3.14 · shard 1/3",
        "windows · python 3.14 · shard 2/3",
        "windows · python 3.14 · shard 3/3",
        "windows · python 3.14 · packaging and shells"
      ]
    },
    "floor-python": {
      "groups": [
        "py"
      ],
      "names": [
        "floor · pip refuses the wheel on Python 3.13"
      ]
    },
    "lint-shell-scripts": {
      "always": true,
      "names": [
        "lint · shellcheck + PSScriptAnalyzer"
      ]
    },
    "floor-lints": {
      "always": true,
      "names": [
        "lint · bash 4.4 and pwsh 7 floors"
      ]
    },
    "coverage": {
      "groups": [
        "py"
      ],
      "names": [
        "coverage · per-module floors"
      ]
    },
    "order-independence": {
      "groups": [
        "py"
      ],
      "names": [
        "suite · shuffled · seed 1",
        "suite · shuffled · seed 20260904"
      ]
    },
    "order-independence-browser": {
      "groups": [
        "desk",
        "static-only"
      ],
      "names": [
        "suite · shuffled · browser · shard 1/2",
        "suite · shuffled · browser · shard 2/2"
      ]
    },
    "vscode-extension": {
      "groups": [
        "ide-vscode"
      ],
      "names": [
        "ide · vscode extension"
      ]
    },
    "jetbrains-plugin": {
      "groups": [
        "ide-jetbrains"
      ],
      "names": [
        "ide · jetbrains plugin"
      ]
    }
  }
}
