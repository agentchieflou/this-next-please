# keep TMDL and fixture bytes exact on Windows checkouts (core.autocrlf must not touch them)
*.tmdl -text
tests/fixtures/** -text
*.dax -text

# Shell scripts are executed, not just read: a CRLF .sh dies under Git Bash with `$'\r': command
# not found`, and cmd.exe wants CRLF for multi-line blocks. Pin both rather than leaving it to
# whatever core.autocrlf a checkout happens to have.
*.sh text eol=lf
*.ps1 text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Vendored third-party files are pinned by sha256 (tests/test_fleet_probe.py). A Windows checkout
# with core.autocrlf=true would rewrite their line endings and ship a three.js that is not r160.
agentdata/fleet/static/vendor/** -text
